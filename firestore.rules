rules_version = '2';

// ============================================================
//  PERINGATAN — TIDAK ADA PENGAMAN DI SINI.
//  Aplikasi ini tidak pakai Firebase Auth. Kata sandi di layar
//  login ("zasha") hanya penghalang tampilan di sisi browser —
//  Firestore tidak tahu apa-apa soal kata sandi itu.
//
//  Akibatnya: SIAPA PUN yang tahu projectId ini (terlihat di
//  source kode publik) bisa membaca DAN MENGHAPUS seluruh data,
//  langsung lewat REST API, tanpa perlu buka aplikasinya sama
//  sekali. Ini pilihan yang disadari, bukan bug.
//
//  Kalau nanti berubah pikiran, pasang Firebase Auth lagi dan
//  ganti allow if true; di bawah dengan pengecekan UID pemilik.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /{dokumen=**} {
      allow read, write: if true;
    }
  }
}
